{
  "manifest_version": 3,
  "name": "Pathlight.ai Tailorer",
  "version": "1.0",
  "description": "Scrapes LinkedIn jobs and automatically tailors resumes via Pathlight.ai.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pathlight.ai Job Tailorer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
